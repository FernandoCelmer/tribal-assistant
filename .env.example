# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./storage/tw.db

# Tribal Wars credentials
TW_WORLD_URL=https://brxx.tribalwars.com.br
TW_USERNAME=your_user
TW_PASSWORD=your_pass
TW_SERVER=brxx

# Browser
HEADLESS=false
BROWSER_STATE_PATH=./storage/playwright-state.json
MIN_DELAY_MS=1200
MAX_DELAY_MS=3800
SYNC_INTERVAL_SECONDS=120
SYNC_REPORT_DETAILS=true
QUIET_HOURS=

# Farm
FARM_ENABLED=true
FARM_MIN_LOOT=10
FARM_MAX_WALL_LEVEL=1

# Telegram (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
