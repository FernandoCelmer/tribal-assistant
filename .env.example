# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./storage/tw.db

# Tribal Wars credentials
TW_WORLD_URL=https://brxx.tribalwars.com.br
TW_USERNAME=your_user
TW_PASSWORD=your_pass
TW_SERVER=brxx

# Browser
HEADLESS=false
BROWSER_STATE_PATH=./storage/playwright-state.json
MIN_DELAY_MS=1200
MAX_DELAY_MS=3800
SYNC_INTERVAL_SECONDS=120
SYNC_REPORT_DETAILS=true
QUIET_HOURS=

# AI (optional): anthropic | openai | grok | gemini | vertex | ollama | openai-compatible | none
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_MAX_STEPS=10


# Database: SQLite locally or PostgreSQL (e.g. on a VPS)
# DATABASE_URL=postgresql+asyncpg://tribal:SENHA@IP_DA_VPS:5432/tribal

# Key that encrypts game passwords stored in the database (optional: storage/secret.key is created otherwise)
# APP_SECRET=

# Accounts live in the database (page /contas or `tribal-assistant accounts add`).
# TW_WORLD_URL / TW_USERNAME / TW_PASSWORD above only create account 1 on the first start.
